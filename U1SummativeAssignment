int sensorValue = 0, brightness = 0, currSensor = 0, heLLo = 0; //currSensor was not named in my setup, I will use it to determine which sensor is in use
const int pinSwitch = 2, LED = 13, pinButton = 12;
const int sensor[] = {A0, A1, A2, A3};


void setup() {
  for (byte i = 0; i <= 3; i++) {
    pinMode(sensor[i], INPUT);
  }
  Serial.begin(9600);
  pinMode(LED, OUTPUT);
  pinMode(pinSwitch, INPUT);
}


void loop() {
if (digitalRead(pinSwitch)==HIGH) {
  heLLo = 0;
  digitalWrite(LED, HIGH);
  sensorValue = analogRead(sensor[currSensor]);
  Serial.print("Your sensor value is: ");
  Serial.println(sensorValue);
  brightness = map(sensorValue, 0, 1023, 0, 255);
  analogWrite(9, brightness);
  delay(100);
  digitalWrite(9, LOW);
}
else {
    if (heLLo == 0){
    Serial.println("Hello user! Please press the button to select your sensor!");
    heLLo++;
  }
  digitalWrite(LED, LOW);
  if(digitalRead(pinButton)==HIGH){
    currSensor++;
    delay(300);
  }
    currSensor = (currSensor % 4);
    Serial.print("Your current sensor is: ");
    Serial.println(currSensor);
    delay(500);
  }
}
